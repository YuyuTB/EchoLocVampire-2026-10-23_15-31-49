/* Conteneur global */
.root-container {
    flex-grow: 1;
    background-color: rgb(10, 10, 10);
    justify-content: center;
    align-items: center;
}

/* Style commun des panneaux */
.panel {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

/* Masque le panneau des contrôles au démarrage */
#ControlsPanel {
    display: none;
}

/* Titres */
.game-title {
    font-size: 56px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.game-subtitle {
    font-size: 18px;
    color: rgb(140, 140, 140);
    margin-bottom: 40px;
}

/* Texte des contrôles */
.controls-text {
    font-size: 20px;
    color: rgb(200, 200, 200);
    width: 600px;
    white-space: normal;
    -unity-text-align: upper-center;
    margin-bottom: 40px;
}

/* Conteneur des boutons */
.button-container {
    width: 300px;
}

/* Style des boutons */
.menu-button {
    background-color: rgba(30, 30, 30, 0.8);
    border-color: rgb(80, 80, 80);
    border-width: 2px;
    border-radius: 6px;
    color: rgb(240, 240, 240);
    font-size: 18px;
    -unity-font-style: bold;
    height: 50px;
    margin-bottom: 15px;
    transition-duration: 0.2s;
}

.menu-button:hover {
    background-color: rgb(200, 30, 30);
    border-color: rgb(255, 100, 100);
    color: rgb(255, 255, 255);
    scale: 1.05;
}

.menu-button:active {
    scale: 0.95;
    background-color: rgb(150, 20, 20);
}

/* Bouton secondaire (Back) */
.secondary-button {
    background-color: rgba(20, 20, 20, 0.5);
    border-color: rgb(60, 60, 60);
}

.secondary-button:hover {
    background-color: rgb(60, 60, 60);
    border-color: rgb(100, 100, 100);
}